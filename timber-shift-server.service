[Unit]
Description=Timber Shift dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timbershift
WorkingDirectory=/opt/timbershift
ExecStart=/opt/timbershift/TimberShiftDedicatedServer.x86_64 --headless --audio-driver Dummy -- --server
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
